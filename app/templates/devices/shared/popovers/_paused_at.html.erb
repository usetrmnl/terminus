<%= scope(:popover_default_content, name: :paused_at, label: "Paused").render do %>
  <p>The date and time when the device was paused via the <em>Pause</em> command. This forces the device to display the current screen, when first paused, until no longer paused.</p>

  <p><em>Cannot be edited</em>.</p>
<% end %>
