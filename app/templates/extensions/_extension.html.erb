<li id="<%= extension.id %>" class="bit-card extension">
  <h2 class="label"><%= extension.label %></h2>

  <%= tag.span extension.kind %>

  <div class="actions">
    <%= link_to routes.path(:extension_edit, id: extension.id),
                class: :action,
                interestfor: "tooltip-action-edit" do %>
      <%= image_tag "icons/edit.svg", alt: "Edit", width: 25, height: 25 %>
    <% end %>

    <%= render "shared/actions/clone",
               path: routes.path(:extension_clone_new, id: extension.id) %>

    <%= render "shared/actions/download",
               path: routes.path(:extension_export, id: extension.id),
               name: "extension-#{extension.name}.zip" %>

    <%= render "shared/actions/delete",
               path: routes.path(:extension, id: extension.id),
               subject: :extension %>
  </div>
</li>
